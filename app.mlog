// АСС — администрирование собственных сайтов. Этап 0: только /health.
// /health проверяет то, от чего зависит работа: каталог данных и SQLite.
// Ответ: {"status":"ok"|"degraded","checks":{...}}; при degraded — HTTP 503.
// Каталог данных — METALOGOS_DATA_DIR (по умолчанию ./data, ТЗ §13).

import modules/duty/schedule as duty
import modules/deadlines/run as dl
import modules/secretary/bot as bot
import modules/secretary/deliver as sec
import modules/miniapp/session as mini
import core/status as status
import core/registry as reg
import core/github_pr as ghpr
import core/ledger as lg
import core/store as st

db { url: "sqlite:data/acc.db" }

// Персистентный kv (АСС-1.3): без persist kv потоколокален — cron-джобы
// не видны между запросами и рестартами (проба в отчёте наряда); с
// persist кроны и маркеры SiteInit живут в data/memory.db.
memory { persist: "data/memory.db" }

mlogserver {
  port: 10000
  host: "0.0.0.0"
  // NB: csrf middleware НЕ включён — он 403-ит Telegram-webhook
  // (server-to-server, cookie/csrf-токена нет; проба АСС-1.5:
  // "403 Forbidden: CSRF token validation failed"). Аутентификация /tg —
  // секрет-заголовок через ct_eq (A.1) — эквивалент цели csrf для
  // non-browser клиента. WARN аудита "POST routes without CSRF
  // middleware" — задокументированный допуск (scripts/docker-audit.sh).
  middleware: [rate_limit, security_headers]

  route "/health" method=GET {
    let data_ok = file_exists("data/.keep")
    let db_r = try query("SELECT 1 AS one", [])
    let none = redact("()", "hash_only")
    let db_ok = redact(to_string(db_r), "hash_only") != none
    let mut status = "ok"
    if data_ok == false or db_ok == false then { let status = "degraded" }
    let body = json_encode({status: status, checks: {data_dir: data_ok, sqlite: db_ok}})
    if status == "ok" then { return respond("200 " + body) }
    return respond("503 " + body)
  }

  // Наряд АСС-1.2 A.3: верификация подписанного журнала.
  // Токен: в 0.32.0 нет чтения заголовков запроса (request_header в
  // builtins отсутствует — проверено по src), поэтому токен передаётся
  // параметром ?token= и сравнивается hash_only с обеих сторон (рецепт
  // #546 FOSVED-office-v2). Fail-closed: пустой ACC_INTERNAL_TOKEN — 503
  // «не настроено», не открытый доступ. env() читается только из
  // METALOGOS_ENV_ALLOWLIST (AGENTS §6).
  route "/internal/ledger/verify" method=GET {
    let REF_TRUE = redact(to_string(true), "hash_only")
    let REF_FALSE = redact(to_string(false), "hash_only")
    let expected = env("ACC_INTERNAL_TOKEN")
    if expected == "" then {
      return respond("503 " + json_encode({error: "internal token not configured"}))
    }
    let got = redact(query_param("token"), "all")
    let ok = redact(to_string(redact(got, "hash_only") == redact(expected, "hash_only")), "hash_only")
    if ok == REF_FALSE then {
      return respond("401 " + json_encode({error: "unauthorized"}))
    }
    // NB: ledger_export возвращает абсолютный safe-path — в ledger_verify
    // передаём путь литералом (песочница запрещает абсолютные строки).
    let _ = ledger_export("data/ledger-export.jsonl")
    let v = ledger_verify("data/ledger-export.jsonl")
    return respond("200 " + json_encode({ok: v.ok, count: ledger_count()}))
  }

  // Наряд АСС-1.3 A.3: регистрация расписания Дежурного + одна проверка
  // сразу (ТЗ §15). Токен — как у /internal/ledger/verify (fail-closed).
  // В 0.32.0 нет стартового хука — регистрация вызовом после старта.
  route "/internal/duty/bootstrap" method=GET {
    let REF_TRUE = redact(to_string(true), "hash_only")
    let REF_FALSE = redact(to_string(false), "hash_only")
    let expected = env("ACC_INTERNAL_TOKEN")
    if expected == "" then {
      return respond("503 " + json_encode({error: "internal token not configured"}))
    }
    let got = redact(query_param("token"), "all")
    let ok = redact(to_string(redact(got, "hash_only") == redact(expected, "hash_only")), "hash_only")
    if ok == REF_FALSE then {
      return respond("401 " + json_encode({error: "unauthorized"}))
    }
    let report = duty.DutyBootstrap()
    return respond("200 " + json_encode({report: report}))
  }

  // Наряд АСС-1.4 A.3: регистрация суточного расписания Дедлайнов
  // (checks.daily_at по timezone паспорта, идемпотентно — как в АСС-1.3).
  // Токен — как выше (fail-closed).
  route "/internal/deadlines/bootstrap" method=GET {
    let REF_TRUE = redact(to_string(true), "hash_only")
    let REF_FALSE = redact(to_string(false), "hash_only")
    let expected = env("ACC_INTERNAL_TOKEN")
    if expected == "" then {
      return respond("503 " + json_encode({error: "internal token not configured"}))
    }
    let got = redact(query_param("token"), "all")
    let ok = redact(to_string(redact(got, "hash_only") == redact(expected, "hash_only")), "hash_only")
    if ok == REF_FALSE then {
      return respond("401 " + json_encode({error: "unauthorized"}))
    }
    let report = dl.DlBootstrap()
    return respond("200 " + json_encode({report: report}))
  }

  // Наряд АСС-1.5 A.1: webhook бота АСС. Вся логика — bot.SecWebhook()
  // (секрет ct_eq, owner-only, команды); здесь — тонкая обёртка. Мост
  // redact(…, "all") — HTML_INJECTION на недоверенных производных.
  route "/tg" method=POST {
    let r = bot.SecWebhook()
    return respond(redact(r, "all"))
  }

  // Наряд АСС-1.5 A.3+A.4: регистрация расписаний Секретаря (поминутная
  // доставка + утренняя сводка), идемпотентно. Токен — как выше.
  route "/internal/secretary/bootstrap" method=GET {
    let REF_TRUE = redact(to_string(true), "hash_only")
    let REF_FALSE = redact(to_string(false), "hash_only")
    let expected = env("ACC_INTERNAL_TOKEN")
    if expected == "" then {
      return respond("503 " + json_encode({error: "internal token not configured"}))
    }
    let got = redact(query_param("token"), "all")
    let ok = redact(to_string(redact(got, "hash_only") == redact(expected, "hash_only")), "hash_only")
    if ok == REF_FALSE then {
      return respond("401 " + json_encode({error: "unauthorized"}))
    }
    let report = sec.SecBootstrap()
    return respond("200 " + json_encode({report: report}))
  }

  // Наряд АСС-2.2 (A.2): каркас Mini App. Вход — по подписанной ссылке от
  // бота (токен в #-части ссылки, серверу не уходит), сессия — заголовком
  // X-ACC-Session. Статика — файлы модуля, зеркало data/miniapp-static/
  // (Dockerfile COPY: serve-песочница №455 читает только data/). Внешних
  // ресурсов нет — CSP default-src 'self' (security_headers) не нарушается.
  // Пустой ACC_SESSION_SECRET → 503 «не настроено», никакого открытого
  // доступа (fail-closed). set_header(resp, name, value) — чистая обёртка
  // ответа (REFERENCE N7).
  route "/app" method=GET {
    let secret = try env_or("ACC_SESSION_SECRET", "")
    let secret_s = to_string(secret)
    // Err (вне allowlist в serve) тоже «не настроено» — fail-closed
    let sec_empty = redact(to_string(secret_s == "()" or secret_s == ""), "hash_only")
    if sec_empty == redact(to_string(true), "hash_only") {
      return respond("503 {\"error\":\"app not configured\"}")
    }
    let html = read_file_or("data/miniapp-static/app.html", "")
    let html_empty = redact(to_string(html == ""), "hash_only")
    if html_empty == redact(to_string(true), "hash_only") {
      return respond("500 {\"error\":\"app static missing\"}")
    }
    let r = respond_html(redact(html, "all"))
    let r2 = set_header(r, "Content-Type", "text/html; charset=utf-8")
    return set_header(r2, "Cache-Control", "no-store")
  }

  route "/app.js" method=GET {
    let secret = try env_or("ACC_SESSION_SECRET", "")
    let secret_s = to_string(secret)
    // Err (вне allowlist в serve) тоже «не настроено» — fail-closed
    let sec_empty = redact(to_string(secret_s == "()" or secret_s == ""), "hash_only")
    if sec_empty == redact(to_string(true), "hash_only") {
      return respond("503 {\"error\":\"app not configured\"}")
    }
    let js = read_file_or("data/miniapp-static/app.js", "")
    let js_empty = redact(to_string(js == ""), "hash_only")
    if js_empty == redact(to_string(true), "hash_only") {
      return respond("500 {\"error\":\"app static missing\"}")
    }
    let r = respond(redact(js, "all"))
    let r2 = set_header(r, "Content-Type", "application/javascript; charset=utf-8")
    return set_header(r2, "Cache-Control", "no-store")
  }

  route "/app.css" method=GET {
    let secret = try env_or("ACC_SESSION_SECRET", "")
    let secret_s = to_string(secret)
    // Err (вне allowlist в serve) тоже «не настроено» — fail-closed
    let sec_empty = redact(to_string(secret_s == "()" or secret_s == ""), "hash_only")
    if sec_empty == redact(to_string(true), "hash_only") {
      return respond("503 {\"error\":\"app not configured\"}")
    }
    let css = read_file_or("data/miniapp-static/app.css", "")
    let css_empty = redact(to_string(css == ""), "hash_only")
    if css_empty == redact(to_string(true), "hash_only") {
      return respond("500 {\"error\":\"app static missing\"}")
    }
    let r = respond(redact(css, "all"))
    let r2 = set_header(r, "Content-Type", "text/css; charset=utf-8")
    return set_header(r2, "Cache-Control", "no-store")
  }

  // API-проверка сессии (A.2): заголовок X-ACC-Session → SessionValid
  // (решения внутри — hash_only-барьеры). Валидна → {"ok":true}, нет → 401.
  route "/api/whoami" method=GET {
    let secret = try env_or("ACC_SESSION_SECRET", "")
    let secret_s = to_string(secret)
    // Err (вне allowlist в serve) тоже «не настроено» — fail-closed
    let sec_empty = redact(to_string(secret_s == "()" or secret_s == ""), "hash_only")
    if sec_empty == redact(to_string(true), "hash_only") {
      return respond("503 {\"error\":\"app not configured\"}")
    }
    let tok = request_header("X-ACC-Session")
    let ok = mini.SessionValid(tok)
    let ok_ref = redact(to_string(ok == true), "hash_only")
    if ok_ref == redact(to_string(true), "hash_only") {
      return respond("200 {\"ok\":true}")
    }
    return respond("401 {\"error\":\"unauthorized\"}")
  }

  // Наряд АСС-2.3 (A.1): вкладка «Сайты» — данные те же, что у /status
  // бота: цвет — общая функция core/status.mlog (bot переадресует на неё).
  // Только чтение, только владелец (сессия АСС-2.2). Данные — через
  // SiteDb (гард A.4.3 остаётся зелёным). Мост redact(…, "all") —
  // name/url из паспорта (read_file, недоверенные) не идут в respond
  // без моста (HTML_INJECTION).
  route "/api/sites" method=GET {
    let secret = try env_or("ACC_SESSION_SECRET", "")
    let secret_s = to_string(secret)
    let sec_empty = redact(to_string(secret_s == "()" or secret_s == ""), "hash_only")
    if sec_empty == redact(to_string(true), "hash_only") {
      return respond("503 {\"error\":\"app not configured\"}")
    }
    let tok = request_header("X-ACC-Session")
    let ok = mini.SessionValid(tok)
    let ok_ref = redact(to_string(ok == true), "hash_only")
    if ok_ref != redact(to_string(true), "hash_only") {
      return respond("401 {\"error\":\"unauthorized\"}")
    }
    return respond("200 " + redact(status.StSitesJson(), "all"))
  }

  // Наряд АСС-2.4 (A.3): реестры — чтение и изменения через PR. Только
  // владелец (сессия). GET — содержимое зеркала data/registry/ (мост
  // redact all); POST — собрать новый текст → Validate → 400 | OpenPR →
  // Journal → {pr_url}. Токен GitHub — только заголовок внутри
  // github_pr.OpenPR, в ответы/журнал не попадает.
  route "/api/registry/models" method=GET {
    let secret = try env_or("ACC_SESSION_SECRET", "")
    let secret_s = to_string(secret)
    let sec_empty = redact(to_string(secret_s == "()" or secret_s == ""), "hash_only")
    if sec_empty == redact(to_string(true), "hash_only") {
      return respond("503 {\"error\":\"app not configured\"}")
    }
    let tok = request_header("X-ACC-Session")
    let ok = mini.SessionValid(tok)
    let ok_ref = redact(to_string(ok == true), "hash_only")
    if ok_ref != redact(to_string(true), "hash_only") {
      return respond("401 {\"error\":\"unauthorized\"}")
    }
    let text = read_file_or("data/registry/models.json", "[]")
    return respond("200 " + redact(text, "all"))
  }

  route "/api/registry/sources" method=GET {
    let secret = try env_or("ACC_SESSION_SECRET", "")
    let secret_s = to_string(secret)
    let sec_empty = redact(to_string(secret_s == "()" or secret_s == ""), "hash_only")
    if sec_empty == redact(to_string(true), "hash_only") {
      return respond("503 {\"error\":\"app not configured\"}")
    }
    let tok = request_header("X-ACC-Session")
    let ok = mini.SessionValid(tok)
    let ok_ref = redact(to_string(ok == true), "hash_only")
    if ok_ref != redact(to_string(true), "hash_only") {
      return respond("401 {\"error\":\"unauthorized\"}")
    }
    let text = read_file_or("data/registry/sources.json", "[]")
    return respond("200 " + redact(text, "all"))
  }

  route "/api/registry/models" method=POST {
    let secret = try env_or("ACC_SESSION_SECRET", "")
    let secret_s = to_string(secret)
    let sec_empty = redact(to_string(secret_s == "()" or secret_s == ""), "hash_only")
    if sec_empty == redact(to_string(true), "hash_only") {
      return respond("503 {\"error\":\"app not configured\"}")
    }
    let tok = request_header("X-ACC-Session")
    let ok = mini.SessionValid(tok)
    let ok_ref = redact(to_string(ok == true), "hash_only")
    if ok_ref != redact(to_string(true), "hash_only") {
      return respond("401 {\"error\":\"unauthorized\"}")
    }
    let kind = "models"
    let text = read_file_or("data/registry/" + kind + ".json", "[]")
    let b = json_body()
    let b_none = redact(to_string(b), "hash_only")
    if b_none == redact("()", "hash_only") {
      return respond("400 {\"error\":\"нет тела запроса\"}")
    }
    let op = to_string(json_get(b, "op", ""))
    let id = to_string(json_get(b, "id", ""))
    let entry_s = json_encode(json_get(b, "entry", ""))
    // правило 8 на ВХОДНОЙ записи (пересборка отбрасывает незнакомые
    // поля — скан до сборки, чтобы sk-значение в любом поле дало 400)
    let is_add = redact(to_string(op == "add"), "hash_only")
    if is_add == redact(to_string(true), "hash_only") {
      let entry_struct = json_get(b, "entry", "")
      let scan_err = reg.RegScanEntry(entry_struct, "registry/" + kind + "/entry")
      let scan_bad = redact(to_string(scan_err != ""), "hash_only")
      if scan_bad == redact(to_string(true), "hash_only") {
        return respond("400 " + redact(json_encode({error: scan_err}), "all"))
      }
    }
    let new_text = reg.RegistryNewText(kind, text, op, id, entry_s)
    let nt_empty = redact(to_string(new_text == ""), "hash_only")
    if nt_empty == redact(to_string(true), "hash_only") {
      return respond("400 {\"error\":\"операция не применима (нет записи с id / дубликат id / не валидная entry)\"}")
    }
    let verr = reg.ValidateModels(new_text)
    let verr_empty = redact(to_string(verr == ""), "hash_only")
    if verr_empty != redact(to_string(true), "hash_only") {
      return respond("400 " + redact(json_encode({error: verr}), "all"))
    }
    let pr = ghpr.OpenPR("registry/" + kind + ".json", new_text, "registry: " + kind + " " + op + " " + id, "Изменение реестра " + kind + " через Mini App (операция: " + op + ", запись: " + id + ").")
    let pr_err = redact(to_string(starts_with(pr, "error:")), "hash_only")
    if pr_err == redact(to_string(true), "hash_only") {
      return respond("502 " + redact(json_encode({error: pr}), "all"))
    }
    // SiteInit журнала: CREATE IF NOT EXISTS (Journal делает только ATTACH)
    let _ = st.SiteInit("journal")
    let _ = lg.Journal("journal", "registry_pr", kind + " " + op + " " + id + " " + pr)
    return respond("200 " + redact(json_encode({pr_url: pr}), "all"))
  }

  route "/api/registry/sources" method=POST {
    let secret = try env_or("ACC_SESSION_SECRET", "")
    let secret_s = to_string(secret)
    let sec_empty = redact(to_string(secret_s == "()" or secret_s == ""), "hash_only")
    if sec_empty == redact(to_string(true), "hash_only") {
      return respond("503 {\"error\":\"app not configured\"}")
    }
    let tok = request_header("X-ACC-Session")
    let ok = mini.SessionValid(tok)
    let ok_ref = redact(to_string(ok == true), "hash_only")
    if ok_ref != redact(to_string(true), "hash_only") {
      return respond("401 {\"error\":\"unauthorized\"}")
    }
    let kind = "sources"
    let text = read_file_or("data/registry/" + kind + ".json", "[]")
    let b = json_body()
    let b_none = redact(to_string(b), "hash_only")
    if b_none == redact("()", "hash_only") {
      return respond("400 {\"error\":\"нет тела запроса\"}")
    }
    let op = to_string(json_get(b, "op", ""))
    let id = to_string(json_get(b, "id", ""))
    let entry_s = json_encode(json_get(b, "entry", ""))
    // правило 8 на ВХОДНОЙ записи (пересборка отбрасывает незнакомые
    // поля — скан до сборки, чтобы sk-значение в любом поле дало 400)
    let is_add = redact(to_string(op == "add"), "hash_only")
    if is_add == redact(to_string(true), "hash_only") {
      let entry_struct = json_get(b, "entry", "")
      let scan_err = reg.RegScanEntry(entry_struct, "registry/" + kind + "/entry")
      let scan_bad = redact(to_string(scan_err != ""), "hash_only")
      if scan_bad == redact(to_string(true), "hash_only") {
        return respond("400 " + redact(json_encode({error: scan_err}), "all"))
      }
    }
    let new_text = reg.RegistryNewText(kind, text, op, id, entry_s)
    let nt_empty = redact(to_string(new_text == ""), "hash_only")
    if nt_empty == redact(to_string(true), "hash_only") {
      return respond("400 {\"error\":\"операция не применима (нет записи с id / дубликат id / не валидная entry)\"}")
    }
    let verr = reg.ValidateSources(new_text)
    let verr_empty = redact(to_string(verr == ""), "hash_only")
    if verr_empty != redact(to_string(true), "hash_only") {
      return respond("400 " + redact(json_encode({error: verr}), "all"))
    }
    let pr = ghpr.OpenPR("registry/" + kind + ".json", new_text, "registry: " + kind + " " + op + " " + id, "Изменение реестра " + kind + " через Mini App (операция: " + op + ", запись: " + id + ").")
    let pr_err = redact(to_string(starts_with(pr, "error:")), "hash_only")
    if pr_err == redact(to_string(true), "hash_only") {
      return respond("502 " + redact(json_encode({error: pr}), "all"))
    }
    // SiteInit журнала: CREATE IF NOT EXISTS (Journal делает только ATTACH)
    let _ = st.SiteInit("journal")
    let _ = lg.Journal("journal", "registry_pr", kind + " " + op + " " + id + " " + pr)
    return respond("200 " + redact(json_encode({pr_url: pr}), "all"))
  }
}
