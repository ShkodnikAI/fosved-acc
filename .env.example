# Только имена переменных. Значения задаются в окружении хостинга, не в репозитории.
# Список имён, которые mlog serve разрешено читать в обработчиках маршрутов (через запятую).
METALOGOS_ENV_ALLOWLIST=
# Каталог данных (ТЗ §13). По умолчанию ./data.
METALOGOS_DATA_DIR=
# Порт HTTP-сервера (Render передаёт сам; mlogserver в app.mlog слушает 10000).
PORT=
# Наряд АСС-1.5: бот АСС (значения — в Render, наряд АСС-1.6; в чат и репозиторий не присылать).
# Токен бота АСС (опция bot: "acc" у send_message читает TELEGRAM_BOT_TOKEN_ACC).
TELEGRAM_BOT_TOKEN_ACC=
# Секрет webhook Telegram (сверяется ct_eq с заголовком X-Telegram-Bot-Api-Secret-Token).
ACC_TELEGRAM_WEBHOOK_SECRET=
# Telegram id владельца (команды принимаются только от него; в логи/ответы не выводится).
ACC_OWNER_TG_ID=
# «Мёртвая рука»: ping-URL Healthchecks.io (АСС пингует после каждого успешного цикла Дежурного).
ACC_HEARTBEAT_URL=
# Наряд АСС-2.2: секрет подписанных ссылок Mini App (случайная строка, например openssl rand -hex 32).
ACC_SESSION_SECRET=
# Наряд АСС-2.2: публичный https-адрес сервиса АСС (база для кнопки /app, например https://<имя>.onrender.com).
ACC_PUBLIC_URL=
# Наряд АСС-2.4: fine-grained GitHub token только на ShkodnikAI/fosved-acc
# (Contents: Read and write, Pull requests: Read and write, срок 90 дней) — изменения реестров через PR.
ACC_GITHUB_TOKEN=
# Наряд АСС-2.4: база GitHub API (дефолт https://api.github.com; тесты — локальный мок).
ACC_GITHUB_API_BASE=
