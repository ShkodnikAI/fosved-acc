// Дедлайны (наряд АСС-1.4, A.2+A.3): суточные проверки сроков сертификата
// и регистрации домена, запись в deadlines, события порогов warn_days.
//
// RunCheck(name, domain) — точка входа A.2 (name: cert|domain — карта
// имя→путь скрипта в коде; отказы — шаги 1–3 ниже):
//   1. name не cert|domain → отказ;
//   2. domain не ^[a-z0-9.-]{3,253}$ → отказ;
//   3. domain должен совпадать с хостом url паспорта (скан зеркала
//      data/sites/, как в Дежурном) — иначе отказ БЕЗ exec. Полигонная
//      задача 5; мутация «снять сверку домена» валит задачу 5;
//   4. exec — единственный в репо (гард CI scripts/check_exec.sh,
//      probes/ исключены как тестовые). Команда фиксированная:
//      python3 <путь из карты> <domain>; ввода из сети в командной
//      строке нет — domain валидирован и сверен с паспортом. В exec_argv
//      аргументы идут через redact(…, "all"): UNTRUSTED_EXEC_DECISION
//      требует trusted-аргументы (проба сессии; категория A без моста);
//   5. вывод скрипта — недоверенный: expires принимается только по
//      ^\d{4}-\d{2}-\d{2}$, source по ^[a-z]{2,12}$; иное — как null;
//   6. результат — запись в deadlines (kind: cert|domain, subject,
//      expires, source, checked_ts; таблица — АСС-1.2 store.mlog);
//   7. expires=null: ручное поле паспорта domain.expires (source=manual);
//      нет и его — событие deadline_unknown раз в сутки (дедуп по
//      календарному дню в events — date(ts,'unixepoch')).
//
// Пороги (A.3): для каждого warn_days паспорта (60/30/7) событие
// deadline_warn — один раз на порог (kv-маркер
// acc_dl_warn:<schema>:<kind>:<subject>:<days>), повторный прогон дублей
// не создаёт. days_left <= 0 — событие deadline_expired при каждом
// суточном прогоне (наряд: «каждые сутки» — намеренно без дедупа).
// days_left = julianday(expires) - julianday('now') (SQLite); срок
// «истекает» в свои сутки (00:00 UTC): до срока 0 дней или меньше.
//
// Расписание (A.3): DlBootstrap() — идемпотентная регистрация cron-джобы
// «deadlines-tick-<daily_at>-<timezone>» на каждую уникальную пару
// daily_at/timezone паспортов с модулем deadlines. Без пачки дублей:
// cron_list сверяется ДО add (проба: cron_add с тем же prompt создаёт
// дубль); смена daily_at/tz меняет prompt — старая джоба снимается как
// устаревшая (remove + add). Вызов — маршрут /internal/deadlines/bootstrap
// (app.mlog, токен ACC_INTERNAL_TOKEN, fail-closed): стартового хука в
// 0.32.0 нет (как в АСС-1.3).
//
// Факты (пробы этой сессии, эталонный бинарь v0.32.0): exec_argv(cmd,
// args) возвращает stdout (Str); не-нулевой код/отсутствие команды — Err
// (ловится try); дефолтный exec-таймаут больше 30 с (проба sleep 30);
// parse_json: json null → to_string = "()"; недоверенный аргумент
// exec_argv — UNTRUSTED_EXEC_DECISION (Category A), мост redact(…, "all").
// each — на верхнем уровне паттернов (замечание АСС-1.3 про VM-бэкенд).
// Ещё факт VM 0.32.0 (проба сессии): повторное объявление имени переменной
// в соседних блоках одного паттерна даёт в рантайме TYPE_MISMATCH
// "String + Float" — имена в разных блоках паттерна сделаны уникальными.

import core/store as st
import core/ledger as lg

pattern DlScriptPath(name: String) -> String {
  // карта имя → путь скрипта (A.2); иные имена — "" (отказ)
  let REF_TRUE = redact(to_string(true), "hash_only")
  let is_cert = redact(to_string(name == "cert"), "hash_only")
  if is_cert == REF_TRUE { return "checks/cert_expiry.py" }
  let is_domain = redact(to_string(name == "domain"), "hash_only")
  if is_domain == REF_TRUE { return "checks/domain_expiry.py" }
  return ""
}

pattern DlHostOf(url: String) -> String {
  // хост из url паспорта: после "//" до первого "/"
  let REF_TRUE = redact(to_string(true), "hash_only")
  let parts = split(url, "//")
  let n = len(parts)
  if redact(to_string(n < 2.0), "hash_only") == REF_TRUE { return "" }
  let rest = to_string(get(parts, 1.0))
  let seg = split(rest, "/")
  return to_string(get(seg, 0.0))
}

pattern DlHasModule(passport_text: String) -> String {
  // "deadlines", если модуль в паспорте, иначе ""
  let REF_TRUE = redact(to_string(true), "hash_only")
  let j = parse_json(passport_text)
  let mods = j.modules
  each m in mods {
    if redact(to_string(m == "deadlines"), "hash_only") == REF_TRUE {
      return "deadlines"
    }
  }
  return ""
}

pattern DlFindSlug(domain: String) -> String {
  // slug сайта, у которого host(url) == domain ("" — нет такого)
  let REF_TRUE = redact(to_string(true), "hash_only")
  let NONE = redact("()", "hash_only")
  let mut found = ""
  each e in list_dir("data/sites") {
    let slug = to_string(e)
    let text = read_file_or("data/sites/" + slug + "/passport.json", "")
    let no_file = redact(to_string(text == ""), "hash_only")
    if no_file != REF_TRUE {
      let r = try parse_json(text)
      // try parse_json → Result {ok, value, error} (рецепт core/passport.mlog)
      let j_ok = redact(to_string(r.ok), "hash_only")
      if j_ok == REF_TRUE {
        let j = r.value
        let host = DlHostOf(to_string(j.url))
        let m = redact(to_string(host == domain), "hash_only")
        if m == REF_TRUE {
          found = slug
        }
      }
    }
  }
  return found
}

pattern DlRecord(schema: String, kind: String, subject: String, expires: String, source: String) -> String {
  // запись результата проверки в deadlines (A.2: kind, source, checked_ts)
  let g = grant_issue("db:insert:" + schema + ".deadlines", 60, "unlimited")
  let _ = db_execute_with_grant(g, "INSERT INTO " + schema + ".deadlines (kind, subject, expires, source, checked_ts) VALUES (?1, ?2, ?3, ?4, ?5)", [kind, subject, expires, source, now()])
  return "ok"
}

pattern DlThresholds(slug: String, schema: String, kind: String, subject: String, expires: String, passport_text: String) -> String {
  // события порогов (A.3). Предусловие: expires прошёл ^\d{4}-\d{2}-\d{2}$
  // (проверено в RunCheck) — иначе julianday вернёт NULL.
  let REF_TRUE = redact(to_string(true), "hash_only")
  let row = query_scalar("SELECT julianday(?1) - julianday('now')", [expires])
  let days_left = to_float(to_string(row))
  let mut warns = 0.0
  // deadline_expired: каждые сутки (наряд A.3) — вне цикла порогов
  let is_exp = redact(to_string(days_left <= 0.0), "hash_only")
  let mut expired = 0.0
  if is_exp == REF_TRUE {
    let _ = lg.Journal(slug, "deadline_expired", kind + " " + subject + " срок истёк " + expires)
    expired = 1.0
  }
  // deadline_warn: один раз на порог — kv-маркер без срока действия
  let j = parse_json(passport_text)
  let dom = j.domain
  each d in dom.warn_days {
    let dd = to_float(to_string(d))
    let hit = redact(to_string(days_left <= dd), "hash_only")
    if hit == REF_TRUE {
      let mk = "acc_dl_warn:" + schema + ":" + kind + ":" + subject + ":" + to_string(dd)
      let fired = redact(to_string(kv_exists(mk)), "hash_only")
      if fired != REF_TRUE {
        let _ = lg.Journal(slug, "deadline_warn", kind + " " + subject + " осталось " + to_string(days_left) + " дн (порог " + to_string(dd) + ", expires " + expires + ")")
        let _ = kv_set(mk, "1")
        warns = warns + 1.0
      }
    }
  }
  return "warns=" + to_string(warns) + " expired=" + to_string(expired) + " days_left=" + to_string(days_left)
}

pattern RunCheck(name: String, domain: String) -> String {
  // Точка входа A.2. Возвращает строку-вердикт: ok|manual|unknown|error|refused.
  let REF_TRUE = redact(to_string(true), "hash_only")
  let NONE = redact("()", "hash_only")
  // 1) карта имён — только cert|domain
  let script = DlScriptPath(name)
  let name_bad = redact(to_string(script == ""), "hash_only")
  if name_bad == REF_TRUE {
    return "refused kind=" + name + " reason=unknown_kind"
  }
  // 2) форма домена
  let dom_ok = redact(to_string(regex_match("^[a-z0-9.-]{3,253}$", domain)), "hash_only")
  if dom_ok != REF_TRUE {
    return "refused kind=" + name + " reason=bad_domain"
  }
  // 3) домен обязан быть хостом url паспорта (отказ БЕЗ exec)
  let slug = DlFindSlug(domain)
  let no_slug = redact(to_string(slug == ""), "hash_only")
  if no_slug == REF_TRUE {
    return "refused kind=" + name + " reason=domain_not_in_passport"
  }
  // 4) exec: фиксированная команда; аргумент — валидированный домен через
  //    redact(…, "all") (UNTRUSTED_EXEC_DECISION)
  let out = try exec_argv("python3", [script, redact(domain, "all")])
  let out_bad = redact(to_string(out), "hash_only")
  if out_bad == NONE {
    return "error kind=" + name + " reason=exec_failed"
  }
  let jr = try parse_json(to_string(out))
  // Result {ok, value, error}; плюс гард полей контракта (has_field)
  let j_ok = redact(to_string(jr.ok), "hash_only")
  if j_ok != REF_TRUE {
    return "error kind=" + name + " reason=bad_json"
  }
  let j = jr.value
  let has_exp = redact(to_string(has_field(j, "expires") == 1.0), "hash_only")
  if has_exp != REF_TRUE {
    return "error kind=" + name + " reason=no_expires_field"
  }
  // 5) expires недоверенный — только строгий формат
  let expires = to_string(j.expires)
  let exp_ok = redact(to_string(regex_match("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", expires)), "hash_only")
  // паспорт сайта — для схемы, ручного поля и порогов
  let text = read_file_or("data/sites/" + slug + "/passport.json", "")
  let schema = st.SiteDb(slug)
  let _ = st.SiteInit(slug)
  if exp_ok == REF_TRUE {
    // 6) source недоверенный — только строчные буквы; нет поля — unknown
    let mut src_use = "unknown"
    let has_src = redact(to_string(has_field(j, "source") == 1.0), "hash_only")
    if has_src == REF_TRUE {
      let src = to_string(j.source)
      let src_ok = redact(to_string(regex_match("^[a-z]{2,12}$", src)), "hash_only")
      if src_ok == REF_TRUE { src_use = src }
    }
    let _ = DlRecord(schema, name, domain, expires, src_use)
    let thr_ok = DlThresholds(slug, schema, name, domain, expires, text)
    return "ok kind=" + name + " expires=" + expires + " source=" + src_use + " " + thr_ok
  }
  // 7) expires=null → ручное поле паспорта domain.expires (source=manual)
  let pr = try parse_json(text)
  let pj_ok = redact(to_string(pr.ok), "hash_only")
  if pj_ok == REF_TRUE {
    let pj = pr.value
    let pdomain = pj.domain
    let manual = to_string(pdomain.expires)
    let manual_ok = redact(to_string(regex_match("^[0-9]{4}-[0-9]{2}-[0-9]{2}$", manual)), "hash_only")
    if manual_ok == REF_TRUE {
      let _ = DlRecord(schema, name, domain, manual, "manual")
      let thr_man = DlThresholds(slug, schema, name, domain, manual, text)
      return "manual kind=" + name + " expires=" + manual + " " + thr_man
    }
  }
  // 8) срок неизвестен — событие deadline_unknown раз в сутки
  let cnt = query_scalar("SELECT COUNT(*) FROM " + schema + ".events WHERE kind = 'deadline_unknown' AND date(ts, 'unixepoch') = date(?1, 'unixepoch')", [now()])
  let n = to_float(to_string(cnt))
  let no_today = redact(to_string(n < 1.0), "hash_only")
  if no_today == REF_TRUE {
    let _ = lg.Journal(slug, "deadline_unknown", name + " " + domain + " срок неизвестен (скрипт и ручное поле)")
  }
  return "unknown kind=" + name
}

pattern DlTickAll() -> String {
  // таргет крона: суточный проход по всем паспортам с модулем deadlines
  let REF_TRUE = redact(to_string(true), "hash_only")
  let mut done = 0.0
  let mut rep = ""
  each e in list_dir("data/sites") {
    let slug = to_string(e)
    let text = read_file_or("data/sites/" + slug + "/passport.json", "")
    let no_file = redact(to_string(text == ""), "hash_only")
    if no_file != REF_TRUE {
      let mod_ok = redact(to_string(DlHasModule(text) == "deadlines"), "hash_only")
      if mod_ok == REF_TRUE {
        let j = parse_json(text)
        let host = DlHostOf(to_string(j.url))
        let r1 = RunCheck("cert", host)
        let r2 = RunCheck("domain", host)
        rep = rep + slug + ": " + r1 + " | " + r2 + "\n"
        done = done + 1.0
      }
    }
  }
  return "deadlines tick sites=" + to_string(done) + "\n" + rep
}

pattern DlBootstrap() -> String {
  // идемпотентная регистрация суточных cron-джоб (A.3) — по одной на
  // уникальную пару daily_at/timezone паспортов с модулем deadlines.
  // each — только на верхнем уровне (АСС-1.3); вложенных each нет.
  let REF_TRUE = redact(to_string(true), "hash_only")
  // 1) wanted: строки "prompt|expr|tz\n" + отдельный список prompt'ов
  let mut wanted = ""
  let mut wanted_prompts = ""
  each e in list_dir("data/sites") {
    let slug = to_string(e)
    let text = read_file_or("data/sites/" + slug + "/passport.json", "")
    let no_file = redact(to_string(text == ""), "hash_only")
    if no_file != REF_TRUE {
      let mod_ok = redact(to_string(DlHasModule(text) == "deadlines"), "hash_only")
      if mod_ok == REF_TRUE {
        let j = parse_json(text)
        let checks = j.checks
        let daily_at = to_string(checks.daily_at)
        let tz = to_string(j.timezone)
        let hm = split(daily_at, ":")
        let h = to_string(to_float(to_string(get(hm, 0.0))))
        let m = to_string(to_float(to_string(get(hm, 1.0))))
        let prompt = "deadlines-tick-" + daily_at + "-" + tz
        let expr = m + " " + h + " * * *"
        wanted = wanted + prompt + "|" + expr + "|" + tz + "\n"
        wanted_prompts = wanted_prompts + prompt + "\n"
      }
    }
  }
  // 2) существующие prompt'ы крона одной строкой
  let mut cron_prompts = ""
  each cj in cron_list() {
    cron_prompts = cron_prompts + to_string(cj.prompt) + "\n"
  }
  // 3) устаревшие джобы (prompt сменился после правки daily_at/tz) — снять
  let mut removed = 0.0
  each cj in cron_list() {
    let is_dl = redact(to_string(contains(to_string(cj.prompt), "deadlines-tick")), "hash_only")
    if is_dl == REF_TRUE {
      let in_wanted = redact(to_string(contains(wanted_prompts, to_string(cj.prompt))), "hash_only")
      if in_wanted != REF_TRUE {
        let _ = cron_remove(to_string(cj.prompt))
        removed = removed + 1.0
      }
    }
  }
  // 4) недостающие — создать
  let mut created = 0.0
  let wlines = split(wanted, "\n")
  each wl in wlines {
    let empty = redact(to_string(wl == ""), "hash_only")
    if empty != REF_TRUE {
      // имена уникальны в пределах паттерна: VM 0.32.0 на повторное
      // объявление prompt/expr/tz (как в части 1 выше) отвечает
      // TYPE_MISMATCH "String + Float" (проба этой сессии)
      let pf = split(wl, "|")
      let w_prompt = to_string(get(pf, 0.0))
      let w_expr = to_string(get(pf, 1.0))
      let w_tz = to_string(get(pf, 2.0))
      let have = redact(to_string(contains(cron_prompts, w_prompt)), "hash_only")
      if have != REF_TRUE {
        let _ = cron_add(w_expr, w_prompt, w_tz, "skip")
        created = created + 1.0
      }
    }
  }
  return "bootstrap deadlines: created=" + to_string(created) + " removed_stale=" + to_string(removed)
}
