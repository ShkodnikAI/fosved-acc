// Валидация реестров (наряд АСС-2.4, A.1; формат — ADR-0002).
//
// ValidateSources(text) / ValidateModels(text) -> String:
//   "" — валидно; иначе текст ошибки (для HTTP 400).
// Проверки: JSON-массив; обязательные поля; id уникален и
// ~ ^[a-z0-9-]{2,40}$; status ∈ active|disabled; (models) key_env ~
// ^[A-Z][A-Z0-9_]{2,63}$; (sources) domain — хост без схемы и пути;
// те же запреты секретов, что в паспорте (правило 8 АСС-1.1 —
// ScanString/ScanSecrets из core/passport.mlog).
//
// Все решения по недоверенным данным (текст из read_file/query) —
// inline-барьер redact(…, "hash_only") (рецепт #546, ADR-0002 примечание).
//
// RegistryNewText(kind, text, op, id, entry_text) -> String — пересборка
// текста реестра для op add|disable|enable|delete; "" — операция не
// применима (нет записи с id / дубликат id при add).
//
// СТРУКТУРНАЯ ДИСЦИПЛИНА (находка АСС-2.3, dbg5–dbg10): внутри each
// присваивание накопителя — ТОЛЬКО формой «acc = acc + <вызов паттерна>»
// (2 операнда, вызов) с ПЛОСКИМИ if до присваивания; многооперандные
// литеральные конкатенации в each→if→if теряются со 2-й итерации.
// Канонический формат файла: каждая запись — compact-JSON одной строкой
// (json_encode: ключи сортированы), записи через ",\n", обёртка
// "[\n"…"\n]"; файлы в репо приведены к нему подготовительным коммитом
// ветки acc-2.4/registries — дифф PR — только изменённые записи.

import core/passport as pp

pattern Contains(s: String, sub: String) -> Bool {
  // NB: REFERENCE пишет Float (1.0/0.0), бинарь 0.32.0 возвращает Bool —
  // допускаем обе формы (AGENTS §2: код первичен)
  let cs = to_string(contains(s, sub))
  return cs == "true" or cs == "1"
}

pattern RegScanEntry(e: Any, path: String) -> String {
  // правило 8 (секреты) для ПЛОСКОЙ записи реестра (ADR-0002).
  // NB: pp.ScanSecrets (рекурсия + type_of-ветвление) на VM возвращает
  // "" молча (проба АСС-2.4: VM clean для sk-/ghp_-значений, interpreter
  // ловит) — здесь плоский обход ключей в проверенной структуре
  // each→if→ScanString→if→return (копия — ловит на VM, проба АСС-2.4).
  // Вложенные значения не сканируются — записи реестров плоские.
  let REF_TRUE = redact(to_string(true), "hash_only")
  let ks = dict_keys(e)
  each k in ks {
    let n1 = redact(to_string(k == "token"), "hash_only")
    if n1 == REF_TRUE { return path + ": запрещённое имя ключа (token)" }
    let n2 = redact(to_string(k == "key"), "hash_only")
    if n2 == REF_TRUE { return path + ": запрещённое имя ключа (key)" }
    let n3 = redact(to_string(k == "secret"), "hash_only")
    if n3 == REF_TRUE { return path + ": запрещённое имя ключа (secret)" }
    let n4 = redact(to_string(k == "password"), "hash_only")
    if n4 == REF_TRUE { return path + ": запрещённое имя ключа (password)" }
    let n5 = redact(to_string(k == "api_key"), "hash_only")
    if n5 == REF_TRUE { return path + ": запрещённое имя ключа (api_key)" }
    let sub = pp.ScanString(to_string(dict_get(e, k, "")), path + "." + k)
    let sub_bad = redact(to_string(sub != ""), "hash_only")
    if sub_bad == REF_TRUE {
      return sub
    }
  }
  return ""
}

pattern RegValidId(id: String) -> Bool {
  return regex_match("^[a-z0-9-]{2,40}$", id)
}

pattern RegValidStatus(status: String) -> Bool {
  return status == "active" or status == "disabled"
}

pattern RegValidKeyEnv(k: String) -> Bool {
  return regex_match("^[A-Z][A-Z0-9_]{2,63}$", k)
}

pattern RegValidHost(h: String) -> Bool {
  // хост без схемы и пути: нет "://" и "/", не пустой
  // (contains в бинаре возвращает Bool: to_string → "true"/"false")
  let c1 = contains(h, "://")
  let c2 = contains(h, "/")
  let c1_off = redact(to_string(to_string(c1) == "false"), "hash_only")
  let c2_off = redact(to_string(to_string(c2) == "false"), "hash_only")
  let not_empty = redact(to_string(h != ""), "hash_only")
  if c1_off == redact(to_string(true), "hash_only") {
    if c2_off == redact(to_string(true), "hash_only") {
      if not_empty == redact(to_string(true), "hash_only") {
        return true
      }
    }
  }
  return false
}

pattern ValidateSources(text: String) -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  let jr = try parse_json(text)
  let none = redact("()", "hash_only")
  let j_err = redact(to_string(jr), "hash_only")
  if j_err == none {
    return "sources: не валидный JSON"
  }
  let j = jr.value
  let mut seen_ids = ","
  let mut n = 0.0
  each e in j {
    let id = to_string(e.id)
    let id_ok = redact(to_string(RegValidId(id)), "hash_only")
    if id_ok != REF_TRUE {
      return "sources: id должен быть ^[a-z0-9-]{2,40}$ (запись " + redact(id, "all") + ")"
    }
    let dup = redact(to_string(Contains(seen_ids, "," + id + ",")), "hash_only")
    if dup == REF_TRUE {
      return "sources: id не уникален: " + redact(id, "all")
    }
    seen_ids = seen_ids + id + ","
    let st = to_string(e.status)
    let st_ok = redact(to_string(RegValidStatus(st)), "hash_only")
    if st_ok != REF_TRUE {
      return "sources: status должен быть active|disabled (запись " + redact(id, "all") + ")"
    }
    let dom = to_string(e.domain)
    let dom_ok = redact(to_string(RegValidHost(dom)), "hash_only")
    if dom_ok != REF_TRUE {
      return "sources: domain должен быть хостом без схемы и пути (запись " + redact(id, "all") + ")"
    }
    let kind = to_string(e.kind)
    let kind_ok = redact(to_string(kind != ""), "hash_only")
    if kind_ok != REF_TRUE {
      return "sources: kind обязателен (запись " + redact(id, "all") + ")"
    }
    let rm = to_string(e.read_method)
    let rm_ok = redact(to_string(rm != ""), "hash_only")
    if rm_ok != REF_TRUE {
      return "sources: read_method обязателен (запись " + redact(id, "all") + ")"
    }
    let tc = e.terms_checked
    let tc_ok = redact(to_string(tc == true or tc == false), "hash_only")
    if tc_ok != REF_TRUE {
      return "sources: terms_checked должен быть true|false (запись " + redact(id, "all") + ")"
    }
    // правило 8 (секреты) — скан всей записи
    let sec = RegScanEntry(e, "registry/sources/" + id)
    let sec_empty = redact(to_string(sec == ""), "hash_only")
    if sec_empty != REF_TRUE {
      return "sources: " + redact(sec, "all")
    }
    n = n + 1.0
  }
  let not_empty = redact(to_string(n > 0.0), "hash_only")
  if not_empty != REF_TRUE {
    return "sources: реестр пуст — добавьте источники или оставьте []"
  }
  return ""
}

pattern ValidateModels(text: String) -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  let jr = try parse_json(text)
  let none = redact("()", "hash_only")
  let j_err = redact(to_string(jr), "hash_only")
  if j_err == none {
    return "models: не валидный JSON"
  }
  let j = jr.value
  let mut seen_ids = ","
  each e in j {
    let id = to_string(e.id)
    let id_ok = redact(to_string(RegValidId(id)), "hash_only")
    if id_ok != REF_TRUE {
      return "models: id должен быть ^[a-z0-9-]{2,40}$ (запись " + redact(id, "all") + ")"
    }
    let dup = redact(to_string(Contains(seen_ids, "," + id + ",")), "hash_only")
    if dup == REF_TRUE {
      return "models: id не уникален: " + redact(id, "all")
    }
    seen_ids = seen_ids + id + ","
    let st = to_string(e.status)
    let st_ok = redact(to_string(RegValidStatus(st)), "hash_only")
    if st_ok != REF_TRUE {
      return "models: status должен быть active|disabled (запись " + redact(id, "all") + ")"
    }
    // значения ключей не вводятся — только имя переменной (наряд, запрет)
    let ke = to_string(e.key_env)
    let ke_ok = redact(to_string(RegValidKeyEnv(ke)), "hash_only")
    if ke_ok != REF_TRUE {
      return "models: key_env — имя переменной окружения ^[A-Z][A-Z0-9_]{2,63}$, не значение (запись " + redact(id, "all") + ")"
    }
    let nm = to_string(e.name)
    let nm_ok = redact(to_string(nm != ""), "hash_only")
    if nm_ok != REF_TRUE {
      return "models: name обязателен (запись " + redact(id, "all") + ")"
    }
    let pv = to_string(e.provider)
    let pv_ok = redact(to_string(pv != ""), "hash_only")
    if pv_ok != REF_TRUE {
      return "models: provider обязателен (запись " + redact(id, "all") + ")"
    }
    let md = to_string(e.model)
    let md_ok = redact(to_string(md != ""), "hash_only")
    if md_ok != REF_TRUE {
      return "models: model обязателен (запись " + redact(id, "all") + ")"
    }
    let sec = RegScanEntry(e, "registry/models/" + id)
    let sec_empty = redact(to_string(sec == ""), "hash_only")
    if sec_empty != REF_TRUE {
      return "models: " + redact(sec, "all")
    }
  }
  return ""
}

pattern RegistryValidate(kind: String, text: String) -> String {
  // диспетчер валидации по kind (models|sources)
  let is_m = redact(to_string(kind == "models"), "hash_only")
  if is_m == redact(to_string(true), "hash_only") {
    return ValidateModels(text)
  }
  return ValidateSources(text)
}

pattern EntrySources(e: Any, status: String) -> String {
  // каноническая запись sources (json_encode сортирует ключи сам)
  return json_encode({id: to_string(e.id), kind: to_string(e.kind), domain: to_string(e.domain), read_method: to_string(e.read_method), frequency: to_string(e.frequency), terms_checked: e.terms_checked, status: status}) + ",\n"
}

pattern EntryModels(e: Any, status: String) -> String {
  return json_encode({id: to_string(e.id), name: to_string(e.name), provider: to_string(e.provider), model: to_string(e.model), key_env: to_string(e.key_env), status: status}) + ",\n"
}

pattern EntryRaw(e: Any) -> String {
  return json_encode(e) + ",\n"
}

pattern EntryWrap(acc: String) -> String {
  // срез ",\n"-хвоста и обёртка массива (канонический формат)
  let n = len(acc)
  return "[\n" + substring(acc, 0.0, n - 2.0) + "\n]"
}

pattern RegistryNewText(kind: String, text: String, op: String, id: String, entry_text: String) -> String {
  // пересборка текста реестра для op; "" — операция не применима
  // (нет записи с id / дубликат id при add). ПЛОСКИЕ if (см. шапку).
  let REF_TRUE = redact(to_string(true), "hash_only")
  let jr = try parse_json(text)
  let none = redact("()", "hash_only")
  let j_err = redact(to_string(jr), "hash_only")
  if j_err == none {
    return ""
  }
  let j = jr.value
  let mut found = 0.0
  let mut acc = ""
  let is_add = redact(to_string(op == "add"), "hash_only")
  let is_delete = redact(to_string(op == "delete"), "hash_only")
  let is_disable = redact(to_string(op == "disable"), "hash_only")
  let is_enable = redact(to_string(op == "enable"), "hash_only")
  let mut new_status = "active"
  if is_disable == REF_TRUE {
    new_status = "disabled"
  }
  let is_src = redact(to_string(kind == "sources"), "hash_only")
  each e in j {
    let eid = to_string(e.id)
    let hit = redact(to_string(eid == id), "hash_only")
    // add: копия всех записей; дубликат id фиксируется
    let add_copy = redact(to_string(is_add == REF_TRUE and hit != REF_TRUE), "hash_only")
    if add_copy == REF_TRUE {
      acc = acc + EntryRaw(e)
    }
    let add_dup = redact(to_string(is_add == REF_TRUE and hit == REF_TRUE), "hash_only")
    if add_dup == REF_TRUE {
      found = found + 1.0
    }
    // delete: копия всех, кроме целевой
    let del_copy = redact(to_string(is_delete == REF_TRUE and hit != REF_TRUE), "hash_only")
    if del_copy == REF_TRUE {
      acc = acc + EntryRaw(e)
    }
    let del_hit = redact(to_string(is_delete == REF_TRUE and hit == REF_TRUE), "hash_only")
    if del_hit == REF_TRUE {
      found = found + 1.0
    }
    // disable/enable: целевая — с новым статусом, остальные — как есть
    let tog_hit = redact(to_string((is_disable == REF_TRUE or is_enable == REF_TRUE) and hit == REF_TRUE), "hash_only")
    if tog_hit == REF_TRUE {
      found = found + 1.0
    }
    let tog_keep = redact(to_string((is_disable == REF_TRUE or is_enable == REF_TRUE) and hit != REF_TRUE), "hash_only")
    if tog_keep == REF_TRUE {
      acc = acc + EntryRaw(e)
    }
    let tog_new = redact(to_string((is_disable == REF_TRUE or is_enable == REF_TRUE) and hit == REF_TRUE), "hash_only")
    if tog_new == REF_TRUE {
      let src_new = redact(to_string(is_src == REF_TRUE), "hash_only")
      if src_new == REF_TRUE {
        acc = acc + EntrySources(e, new_status)
      }
      let not_src = redact(to_string(is_src != REF_TRUE), "hash_only")
      if not_src == REF_TRUE {
        acc = acc + EntryModels(e, new_status)
      }
    }
  }
  // add: новая запись в конец (без дубликата)
  let add_append = redact(to_string(is_add == REF_TRUE and found < 1.0), "hash_only")
  if add_append == REF_TRUE {
    let ne = try parse_json(entry_text)
    let ne_ok = redact(to_string(ne.ok), "hash_only")
    if ne_ok == REF_TRUE {
      let entry = ne.value
      let is_struct = redact(to_string(type_of(entry) == "Struct"), "hash_only")
      if is_struct != REF_TRUE {
        return ""
      }
      let src_new = redact(to_string(is_src == REF_TRUE), "hash_only")
      if src_new == REF_TRUE {
        acc = acc + EntrySources(entry, to_string(entry.status))
      }
      let not_src = redact(to_string(is_src != REF_TRUE), "hash_only")
      if not_src == REF_TRUE {
        acc = acc + EntryModels(entry, to_string(entry.status))
      }
    }
  }
  // операции по id: запись должна существовать; add — без дубликата
  let needs_id = redact(to_string(op == "disable" or op == "enable" or op == "delete"), "hash_only")
  if needs_id == REF_TRUE {
    let missing = redact(to_string(found < 1.0), "hash_only")
    if missing == REF_TRUE {
      return ""
    }
  }
  let add_dup2 = redact(to_string(is_add == REF_TRUE and found > 0.0), "hash_only")
  if add_dup2 == REF_TRUE {
    return ""
  }
  return EntryWrap(acc)
}
