// Хранилище сайта (наряд АСС-1.2, A.1; миграция АСС-1.12 #44; ТЗ §4 —
// изоляция, §13 — таблицы).
// Один файл SQLite на сайт: data/sites/<slug>/site.db.
//
// Факты (пробы 0.32.0, см. отчёт наряда):
//  - подключение к базе в serve свежее на каждый запрос (проба A.2:
//    kv-маркер жил, подключение — нет), поэтому SiteDb подключает (ATTACH)
//    при каждом использовании; алиас схемы ПОСТОЯННЫЙ — site (см. ниже),
//    перед подключением предыдущий файл запроса отключается (DETACH);
//  - write_file/ATTACH каталоги не создают: каталог data/sites/<slug>/
//    создаётся деплоем/шагом CI (mkdir); его отсутствие — громкая ошибка;
//  - с Metalogos 0.34.1 (№831) SQL только буквальный; файл сайта
//    подключается под постоянным алиасом site (ATTACH ? AS site),
//    личность файла проверяется по site.meta;
//  - санкционированный канал записи — db_execute_with_grant (грант-алгебра
//    ограничивает op:table в рантайме), чтение — query_scalar/query_row;
//  - taint: slug из сети/read_file недоверен; решения — только через
//    inline-барьер redact(…, "hash_only") (рецепт #546 FOSVED-office-v2).
//
// Все запросы к данным сайта — литеральной схемой site ПОСЛЕ вызова
// SiteDb(slug) в том же запросе (она подключает файл этого сайта;
// переключение сайта — повторный SiteDb с другим slug). ATTACH/DETACH
// баз данных вне core/store.mlog запрещены (гард C.2 наряда #44:
// scripts/check_store_access.sh).
//
// Громкая ошибка: require() в 0.32.0 — ролевой гейт (проверка роли
// пользователя сервера), а не assert; роль-независимый способ упасть —
// assert_eq (Err при неравенстве). Loud(cond_hash, what) поднимает ошибку
// с человекочитаемым префиксом what: cond_hash — результат
// redact(to_string(<предикат>), "hash_only").

pattern Loud(cond_hash: String, what: String) -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  assert_eq(what + cond_hash, what + REF_TRUE)
  return "ok"
}

pattern SiteDb(slug: String) -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  // 1. slug: ^[a-z0-9-]{2,32}$ — иначе громкая ошибка (Loud/assert_eq).
  //    Точка входа для traversal: "../a", "A", "a;DROP" здесь отбрасываются.
  let slug_ok = redact(to_string(regex_match("^[a-z0-9-]{2,32}$", slug)), "hash_only")
  let _ = Loud(slug_ok, "SiteDb: slug должен состоять из строчных букв, цифр и дефиса, 2–32 символа; hash=")
  // 2. отключение предыдущего файла запроса: алиас постоянный (site),
  //    файл — нет. На первом вызове запроса алиаса ещё нет — ошибка
  //    «no such database» ловится try, это норма.
  let g = grant_issue("db:attach:site", 60, "unlimited")
  let _ = try db_execute_with_grant(g, "DETACH DATABASE site", [])
  // 3. подключение файла сайта: путь — ПАРАМЕТР (значение), алиас —
  //    литерал. ATTACH создаёт файл, если каталог существует; нет
  //    каталога data/sites/<slug>/ — ошибка подключения, её громко
  //    поднимает проба ниже.
  let _ = try db_execute_with_grant(g, "ATTACH DATABASE ? AS site", ["data/sites/" + slug + "/site.db"])
  // 4. проба файла на текущем подключении (литеральная); провал — громкая
  //    ошибка (типичный случай: нет каталога data/sites/<slug>/)
  let probe = try query_scalar("SELECT COUNT(*) FROM site.sqlite_master", [])
  let probe_ok = redact(to_string(to_string(probe) != "()"), "hash_only")
  let _ = Loud(probe_ok, "SiteDb: схема сайта не доступна — проверьте каталог data/sites/<slug>/ и права на файл; hash=")
  // 5. личность файла (A.1.5): SiteInit пишет ('slug', <slug>) в site.meta;
  //    файл с чужим slug — громкая ошибка (подмена/перепутанный каталог);
  //    строки нет (сайт ещё не инициализирован) — пропуск. Гвард —
  //    позитивный (в 0.32.0 нет отрицания): «нет строки ИЛИ строка = slug».
  let meta = try query_scalar("SELECT v FROM site.meta WHERE k = 'slug'", [])
  let no_meta = to_string(meta) == "()"
  let own_meta = to_string(meta) == slug
  let id_ok = redact(to_string(no_meta or own_meta), "hash_only")
  let _ = Loud(id_ok, "SiteDb: файл принадлежит другому сайту; hash=")
  return "site"
}

pattern SiteInit(slug: String) -> String {
  let _ = SiteDb(slug)
  // A.2 наряда #50: «инициализировано» решает САМ ФАЙЛ, не kv. Проба A.1
  // (05.11, пять ног на одном data-каталоге): kv-маркер acc_inited_<slug>
  // ПЕРЕЖИВАЕТ рестарт на 0.33.2 и 0.38.3 — persist data/memory.db
  // (app.mlog memory { persist }) читается обратно обоими бинарями,
  // вопреки прежнему комментарию «после рестарта маркер пуст». Ранний
  // return по маркеру при файле сайта без таблиц навсегда блокировал
  // CREATE — прод-инцидент 05.11: POST /tg → 500 no such table:
  // site.incidents (пробы L3/L4 — та же подпись на обоих бинарях).
  // CREATE TABLE IF NOT EXISTS идемпотентны и дёшевы — выполняем при
  // каждом вызове; kv-маркер остаётся диагностической записью, решающей
  // роли больше не играет. Ключ маркера — по slug (алиас site один на
  // все сайты, ключом схемы больше не различить).
  let g = grant_issue("db:insert:site.tables", 60, "unlimited")
  let _ = db_execute_with_grant(g, "CREATE TABLE IF NOT EXISTS site.health_checks (id INTEGER PRIMARY KEY AUTOINCREMENT, ts REAL, url TEXT, status INTEGER, ms REAL, text_ok INTEGER, error TEXT)", [])
  let _ = db_execute_with_grant(g, "CREATE TABLE IF NOT EXISTS site.deadlines (id INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT, subject TEXT, expires TEXT, source TEXT, checked_ts REAL)", [])
  let _ = db_execute_with_grant(g, "CREATE TABLE IF NOT EXISTS site.incidents (id INTEGER PRIMARY KEY AUTOINCREMENT, opened_ts REAL, closed_ts REAL, kind TEXT, summary TEXT, notified_ts REAL)", [])
  let _ = db_execute_with_grant(g, "CREATE TABLE IF NOT EXISTS site.events (id INTEGER PRIMARY KEY AUTOINCREMENT, ts REAL, kind TEXT, text TEXT, sent_ts REAL)", [])
  // личность файла (A.1.5): маркер владельца файла; INSERT OR IGNORE —
  // повторная инициализация не перезаписывает чужой/свой маркер.
  let _ = db_execute_with_grant(g, "CREATE TABLE IF NOT EXISTS site.meta (k TEXT PRIMARY KEY, v TEXT)", [])
  let _ = db_execute_with_grant(g, "INSERT OR IGNORE INTO site.meta (k, v) VALUES ('slug', ?1)", [slug])
  let _ = kv_set("acc_inited_" + slug, "1")
  return "ok"
}
