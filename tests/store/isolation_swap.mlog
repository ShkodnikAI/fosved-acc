// B.2.5 наряда АСС-1.12 (#44): подмена файла сайта копией файла другого
// сайта — SiteDb громко падает по личности файла (site.meta, A.1.5).
//
// Запуск из корня репо ПОСЛЕ подмены (шаг CI store):
//   cp data/sites/aa/site.db data/sites/bb/site.db
//   mlog run tests/store/isolation_swap.mlog 2> swap.err
// Ожидаемо: SWAP OK=1 FAIL=0 и в stderr громкая ошибка
// «SiteDb: файл принадлежит другому сайту» — в файле bb маркер slug='aa'.
// Чистый прогон: rm -f data/sites/aa/site.db data/sites/bb/site.db,
// поднять файлы тестом tests/store/isolation.mlog, затем cp + этот прогон.

import core/store as st

db { url: "sqlite::memory:" }

pattern Main1(_: String) -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  let mut ok = 0.0
  let mut fail = 0.0
  // файл bb — копия файла aa: SiteDb("bb") обязан упасть громко (A.1.5)
  let e = try st.SiteDb("bb")
  let caught = redact(to_string(to_string(e) == "()"), "hash_only")
  if caught == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  return "SWAP OK=" + to_string(ok) + " FAIL=" + to_string(fail)
}

flow Main {
  input: String = "" -> Main1 -> output
}
