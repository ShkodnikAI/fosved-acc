// Тест изоляции сайтов и журнала (наряд АСС-1.2, A.4; A.3 — подделка;
// АСС-1.12 #44 B.2 — изоляция постоянного алиаса site в одном запросе).
//
// Запуск из корня репо:
//   mkdir -p data/sites/aa data/sites/bb
//   rm -f data/sites/aa/site.db data/sites/bb/site.db   (чистый прогон)
//   mlog run tests/store/isolation.mlog 2> isolation.err
// Ожидаемо: ISOLATION OK=12 FAIL=0.
// (файлы журнала — в корне CWD: песочница ledger_export запрещает
// подкаталоги; *.jsonl в .gitignore)
// В stderr при этом по одной громкой ошибке «SiteDb: slug …» на каждый
// плохой slug (../a, A, a;DROP) — их ловит try, это ожидаемое поведение;
// CI-шаг проверяет наличие этих сообщений в stderr (мутация: убрать
// regex-проверку в SiteDb → сообщений нет, шаг красный).
//
// Фикстурные слаги — «aa»/«bb» (не «a»/«b»): regex наряда
// ^[a-z0-9-]{2,32}$ требует минимум 2 символа.
//
// Проверяемые правила (счётчик OK):
//  1. запись A в health_checks видна сайту A (алиас site → файл aa);
//  2. сайт B ту строку не видит (переключение алиаса в одном запросе);
//  3. B пишет и сразу видит своё;
//  4. A после возврата видит ровно одну свою запись;
//  5. A не видит запись B;
//  6–8. SiteDb("../a"), SiteDb("A"), SiteDb("a;DROP") — громкая ошибка;
//  9. Journal пишет строку в events сайта;
//  10. подписанный журнал непуст (запись от гранта Journal);
//  11. целый экспорт журнала проходит ledger_verify (ok=true);
//  12. экспорт с подменённой строкой не проходит (ok=false).
//
// Подмена файла B копией файла A (B.2.5) — отдельным прогоном
// tests/store/isolation_swap.mlog ПОСЛЕ cp data/sites/aa/site.db
// data/sites/bb/site.db (шаг CI store): байтовую копию внутри mlog-прогона
// сделать нечем (read/write_file портят бинарник, ATTACH вне
// core/store.mlog запрещён гардом C.2), а порядок «сначала копия файла,
// потом прогон» проверяет тот же путь обнаружения A.1.5 (site.meta).
//
// Плохие slug (../a, A, a;DROP) проверяются тем же прогоном: try ловит
// громкую ошибку SiteDb, тест считает «ошибка случилась» за OK.

import core/store as st
import core/ledger as lg

db { url: "sqlite::memory:" }

pattern Main1(_: String) -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  let mut ok = 0.0
  let mut fail = 0.0
  let markerA = "probe-a-" + to_string(now())
  let markerB = "probe-b-" + to_string(now())
  // ── 1: A пишет, видит своё ──
  let _ = st.SiteDb("aa")
  let _ = st.SiteInit("aa")
  let ga = grant_issue("db:insert:site.health_checks", 60, "unlimited")
  let _ = db_execute_with_grant(ga, "INSERT INTO site.health_checks (ts, url, status, ms, text_ok, error) VALUES (?1, ?2, ?3, ?4, ?5, ?6)", [now(), markerA, 200.0, 12.0, 1.0, ""])
  let c1 = query_scalar("SELECT COUNT(*) FROM site.health_checks WHERE url = ?1", [markerA])
  let vis = redact(to_string(to_string(c1) == "1"), "hash_only")
  if vis == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 2: B не видит запись A (переключение алиаса в том же запросе) ──
  let _ = st.SiteDb("bb")
  let _ = st.SiteInit("bb")
  let c2 = query_scalar("SELECT COUNT(*) FROM site.health_checks WHERE url = ?1", [markerA])
  let iso = redact(to_string(to_string(c2) == "0"), "hash_only")
  if iso == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 3: B пишет и сразу видит своё ──
  let gb = grant_issue("db:insert:site.health_checks", 60, "unlimited")
  let _ = db_execute_with_grant(gb, "INSERT INTO site.health_checks (ts, url, status, ms, text_ok, error) VALUES (?1, ?2, ?3, ?4, ?5, ?6)", [now(), markerB, 200.0, 12.0, 1.0, ""])
  let c3 = query_scalar("SELECT COUNT(*) FROM site.health_checks WHERE url = ?1", [markerB])
  let own_b = redact(to_string(to_string(c3) == "1"), "hash_only")
  if own_b == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 4: A после возврата видит ровно одну свою ──
  let _ = st.SiteDb("aa")
  let c4 = query_scalar("SELECT COUNT(*) FROM site.health_checks WHERE url = ?1", [markerA])
  let back_a = redact(to_string(to_string(c4) == "1"), "hash_only")
  if back_a == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 5: A не видит запись B ──
  let c5 = query_scalar("SELECT COUNT(*) FROM site.health_checks WHERE url = ?1", [markerB])
  let iso2 = redact(to_string(to_string(c5) == "0"), "hash_only")
  if iso2 == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 6–8: плохие slug — громкая ошибка (сообщение в stderr) ──
  let e1 = try st.SiteDb("../a")
  let e2 = try st.SiteDb("A")
  let e3 = try st.SiteDb("a;DROP")
  let r1 = redact(to_string(to_string(e1) == "()"), "hash_only")
  if r1 == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  let r2 = redact(to_string(to_string(e2) == "()"), "hash_only")
  if r2 == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  let r3 = redact(to_string(to_string(e3) == "()"), "hash_only")
  if r3 == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 9: Journal — строка в events сайта ──
  let _ = st.SiteDb("aa")
  let _ = lg.Journal("aa", "isolation", "тест изоляции: запись в aa")
  let ce = query_scalar("SELECT COUNT(*) FROM site.events", [])
  let ev = redact(to_string(to_float(to_string(ce)) >= 1.0), "hash_only")
  if ev == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 10: подписанный журнал непуст ──
  let n = ledger_count()
  let led = redact(to_string(n >= 1.0), "hash_only")
  if led == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 11–12: подделка журнала обнаруживается (рецепт пробы B.6) ──
  // NB: ledger_export возвращает абсолютный safe-path — в ledger_verify
  // передаём тот же путь ЛИТЕРАЛОМ (песочница запрещает абсолютные строки;
  // так же устроена проба B.6).
  let _ = ledger_export("ledger-export.jsonl")
  let v = ledger_verify("ledger-export.jsonl")
  let good = redact(to_string(to_string(v.ok) == "true"), "hash_only")
  if good == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  let raw = read_file("ledger-export.jsonl")
  let lines = split(raw, "\n")
  let first = to_string(get(lines, 0.0))
  let tampered_first = replace(first, "\"scope\"", "\"scopX\"")
  let tampered = replace(raw, first, tampered_first)
  if redact(tampered, "hash_only") == redact(raw, "hash_only") { fail = fail + 1.0 }
  let _ = write_file("ledger-tampered.jsonl", tampered)
  let v2 = ledger_verify("ledger-tampered.jsonl")
  let bad = redact(to_string(to_string(v2.ok) == "false"), "hash_only")
  if bad == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  return "ISOLATION OK=" + to_string(ok) + " FAIL=" + to_string(fail)
}

flow Main {
  input: String = "" -> Main1 -> output
}
