// Тест самолечения SiteInit (наряд #50, A.2): повреждённое состояние
// прод-инцидента 05.11 — файл сайта есть (пустой), kv-маркер «инициализировано»
// выставлен, таблиц нет. SiteInit обязан создать таблицы (проверка — по
// самому файлу, не по kv); запрос класса /status (SELECT COUNT(*) FROM
// site.incidents) отвечает. Мутация «вернуть ранний return по kv-маркеру» —
// тест красный (шаги 3–4 не проходят: no such table).
//
// Запуск из корня репо:
//   mkdir -p data/sites/ha
//   rm -f data/sites/ha/site.db data/sites/ha/site.db-wal data/sites/ha/site.db-shm
//   mlog run tests/store/heal.mlog 2> heal.err
// Ожидаемо: HEAL OK=5 FAIL=0
//
// Слаг-фикстура «ha» (≥2 символов — regex SiteDb ^[a-z0-9-]{2,32}$).
db { url: "sqlite:data/acc.db" }

import core/store as st

pattern Main1(_: String) -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  let mut ok = 0.0
  let mut fail = 0.0
  // ── 1. предусловие инцидента: маркер выставлен, таблиц ещё нет ──
  // ATTACH создаёт пустой файл (каталог data/sites/ha создан шагом CI);
  // маркер ставится БЕЗ инициализации — точное состояние прода 05.11.
  let _ = st.SiteDb("ha")
  let _ = kv_set("acc_inited_ha", "1")
  let marker = redact(to_string(kv_exists("acc_inited_ha")), "hash_only")
  if marker == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 2. SiteInit самолечится: таблицы созданы (≥5: health_checks,
  //      deadlines, incidents, events, meta) ──
  let _ = st.SiteInit("ha")
  let nt = try query_scalar("SELECT COUNT(*) FROM site.sqlite_master WHERE type = 'table'", [])
  let nt_v = to_string(nt)
  let nt_ok = redact(to_string(to_float(nt_v) >= 5.0), "hash_only")
  if nt_ok == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 3. запрос класса /status отвечает (тот же, что в StSiteColor) ──
  let ni = try query_scalar("SELECT COUNT(*) FROM site.incidents WHERE closed_ts IS NULL", [])
  let ni_ok = redact(to_string(to_string(ni) != "()"), "hash_only")
  if ni_ok == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 4. идемпотентность: повторный SiteInit не теряет данные ──
  let gi = grant_issue("db:insert:site.tables", 60, "unlimited")
  let _ = db_execute_with_grant(gi, "INSERT INTO site.events (ts, kind, text) VALUES (?1, 'probe', 'heal')", [now()])
  let _ = st.SiteInit("ha")
  let ne = try query_scalar("SELECT COUNT(*) FROM site.events WHERE kind = 'probe'", [])
  let ne_ok = redact(to_string(to_float(to_string(ne)) >= 1.0), "hash_only")
  if ne_ok == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── 5. личность файла на месте (site.meta, A.1.5) ──
  let sl = try query_scalar("SELECT v FROM site.meta WHERE k = 'slug'", [])
  let sl_ok = redact(to_string(to_string(sl) == "ha"), "hash_only")
  if sl_ok == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  return "HEAL OK=" + to_string(ok) + " FAIL=" + to_string(fail)
}

flow Main {
  input: String = "" -> Main1 -> output
}
