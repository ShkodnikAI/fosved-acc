// Юниты разведки (наряд АСС-2.5, A.3; ремонт — наряд АСС-1.9 #33).
// Запуск: tests/intake/run.sh (поднимает фейк-сайты 18488/18489 и
// METALOGOS_ALLOW_EXEC/ALLOW_PRIVATE — только в тесте).
// Ожидаемо: POLYGON intake 8/8 (deny-ветка теста 3 — в deny.mlog,
// отдельный процесс БЕЗ METALOGOS_HTTP_ALLOW_PRIVATE: флаг снимает
// проверку целиком (core/allowlist.mlog, документировано), поэтому под
// ним deny-ветка непроверяема в принципе).
//
//  тест 1: сайт с /be/, /en/, /ru/, /health → languages ["ru","be","en"],
//          health_url найден (found_auto содержит repo.health_url);
//  тест 2: сайт без /health → health_url: null, в found_auto его нет;
//  тест 3: (перенесён в tests/intake/deny.mlog — процесс без флага);
//  тест 4: черновик проходит ValidatePassportDraft (null допустим) —
//          СЕЙЧАС КРАСЕН: core/passport.mlog отвергает slug:null вопреки
//          собственному докстрингу (json_get с default сворачивает
//          null → "", REFERENCE.md:919; ветка type_of=="Null" мертва);
//          фикс в запретной зоне #33 — ждёт вердикта владельца;
//  тест 5: повторная заявка — одна запись в intake_drafts (обновление).

import modules/intake/recon as intake
import core/passport as pp
import core/allowlist as aw
import core/store as st
import core/registry as reg

db { url: "sqlite:data/acc.db" }

pattern Contains(s: String, sub: String) -> Bool {
  // NB: contains в бинаре возвращает Bool (REFERENCE пишет Float)
  let cs = to_string(contains(s, sub))
  return cs == "true" or cs == "1"
}

pattern DraftOf(url: String) -> String {
  let r = query_row("SELECT draft FROM intake_drafts WHERE url = ?1", [url])
  let n = len(r)
  if redact(to_string(to_float(to_string(n)) < 1.0), "hash_only") == redact(to_string(true), "hash_only") {
    return ""
  }
  return to_string(get(r, 0.0))
}

pattern Main1(_: String) -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  let mut ok = 0.0
  let mut fail = 0.0
  let full = "http://127.0.0.1:18488"
  let min = "http://127.0.0.1:18489"
  // ── тест 1: полный сайт → черновик с языками [ru,be,en] и health_url ──
  let rep1 = intake.IntakeCommand(full)
  let d1 = DraftOf(full)
  let d1_ok = redact(to_string(d1 != ""), "hash_only")
  if d1_ok == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  let lang_hit = redact(to_string(Contains(d1, "\"languages\":[\"ru\",\"be\",\"en\"]")), "hash_only")
  if lang_hit == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  let hu_hit = redact(to_string(Contains(d1, "\"health_url\":\"http://127.0.0.1:18488/health\"")), "hash_only")
  if hu_hit == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  let fa_hit = redact(to_string(Contains(d1, "\"repo.health_url\"")), "hash_only")
  if fa_hit == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── тест 2: сайт без /health → null, не в found_auto ──
  let _ = intake.IntakeCommand(min)
  let d2 = DraftOf(min)
  let hu_null = redact(to_string(Contains(d2, "\"health_url\":null")), "hash_only")
  if hu_null == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  let fa_absent = redact(to_string(Contains(d2, "repo.health_url") == false), "hash_only")
  if fa_absent == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // тест 3 перенесён в tests/intake/deny.mlog (процесс без
  // METALOGOS_HTTP_ALLOW_PRIVATE — см. шапку)
  // ── тест 4: черновик проходит draft-валидацию ──
  // Предмет теста — slug:null (докстринг passport, #37 D3-а). Фейк-сайт
  // http:// — схема не предмет теста (правило url честно требует https://):
  // подменяем схему, чтобы вердикт зависел только от slug-ветки.
  let d1_https = replace(d1, "\"http://", "\"https://")
  let v = pp.ValidatePassportDraft(d1_https)
  let t4 = redact(to_string(v == "ok"), "hash_only")
  if t4 == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  // ── тест 5: повторная заявка — одна запись ──
  let _ = intake.IntakeCommand(full)
  let cnt = intake.IntakeDraftCount(full)
  let t5 = redact(to_string(cnt == 1.0), "hash_only")
  if t5 == REF_TRUE { ok = ok + 1.0 } else { fail = fail + 1.0 }
  let mut verdict = "POLYGON intake FAIL (OK=" + to_string(ok) + " FAIL=" + to_string(fail) + ")"
  if redact(to_string(fail == 0.0), "hash_only") == REF_TRUE {
    // ярлык должен совпадать с фактическим числом проверок (8): при
    // добавлении/удалении проверки обновить здесь И grep в run.sh —
    // расхождение ловится мутационным тестом (наряд #33, A.3)
    verdict = "POLYGON intake 8/8"
  }
  return verdict
}

flow Main {
  input: String = "" -> Main1 -> output
}
