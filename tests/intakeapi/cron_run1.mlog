// Тест A.5.5, прогон 1 (наряд АСС-2.6): старт приложения №1 — паспорт
// сайта one БЕЗ модуля duty. Регистрация расписаний при старте (#39):
//   - Дедлайны: joba deadlines-tick-07:00-Europe/Minsk (из паспорта one);
//   - Дежурный: duty-tick НЕ регистрируется (ни у одного паспорта нет duty).
// Ожидаемо: CRON1 dl07=1 duty=0

import modules/duty/schedule as ds
import modules/deadlines/run as dl

db { url: "sqlite:data/acc.db" }

pattern HasPrompt(p: String) -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  let mut found = "0"
  each j in cron_list() {
    let hit = redact(to_string(to_string(j.prompt) == p), "hash_only")
    if hit == REF_TRUE {
      found = "1"
    }
  }
  return found
}

pattern Main1(_: String) -> String {
  // старт: регистрация расписаний (как start.sh после /health)
  let _ = ds.DutyBootstrap()
  let _ = dl.DlBootstrap()
  let dl07 = HasPrompt("deadlines-tick-07:00-Europe/Minsk")
  let duty = HasPrompt("duty-tick")
  print("CRON1 dl07=" + dl07 + " duty=" + duty)
  return "cron1 done"
}

flow Main {
  input: String = "" -> Main1 -> output
}
