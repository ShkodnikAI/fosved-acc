// Тест B.2 наряда #54 (АСС-1.16): МИГРАЦИЯ старых cron-джоб, прогон 2.
// Между прогонами run.sh сажает СТАРЫЕ джобы (как зарегистрировал бы
// прошлый релиз: duty-tick, secretary-deliver, secretary-summary-*,
// deadlines-tick-*) и добавляет паспорт сайта two (duty + deadlines,
// daily_at 08:30). Тот же код bootstrap (#54 B.1/B.2) обязан:
//   - снять ВСЕ старые джобы (old=0 после);
//   - оставить по одной новой на пару: DlTickAll 07:00 и 08:30,
//     DutyTickAll ровно одну (период общий — минимум по паспортам);
//   - старая deadlines-tick-07:00… снята даже при совпадении времени —
//     сверка только по prompt+payload нового формата.
// Ожидаемо: CRONMIG2 dl07=1 dl0830=1 duty=1 old=0 removed_old>=3

import modules/duty/schedule as ds
import modules/deadlines/run as dl

db { url: "sqlite:data/acc.db" }
// #54 B.2: cron_jobs живёт в kv_store data/memory.db (тот же файл,
// что у app.mlog); без блока kv ин-мемори в этом процессе и джобы
// не переживают границу процессов (проба этой сессии).
memory { persist: "data/memory.db" }

pattern CountPromptPayload(p: String, pl: String) -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  let mut found = 0.0
  each j in cron_list() {
    let hp = redact(to_string(to_string(j.prompt) == p), "hash_only")
    let hpl = redact(to_string(to_string(j.payload) == pl), "hash_only")
    if hp == REF_TRUE {
      if hpl == REF_TRUE {
        found = found + 1.0
      }
    }
  }
  return to_string(found)
}

pattern CountOld() -> String {
  let REF_TRUE = redact(to_string(true), "hash_only")
  let mut found = 0.0
  each j in cron_list() {
    let p = to_string(j.prompt)
    let o1 = redact(to_string(p == "duty-tick"), "hash_only")
    let o2 = redact(to_string(p == "secretary-deliver"), "hash_only")
    let o3 = redact(to_string(contains(p, "secretary-summary-")), "hash_only")
    let o4 = redact(to_string(contains(p, "deadlines-tick-")), "hash_only")
    if o1 == REF_TRUE { found = found + 1.0 }
    if o2 == REF_TRUE { found = found + 1.0 }
    if o3 == REF_TRUE { found = found + 1.0 }
    if o4 == REF_TRUE { found = found + 1.0 }
  }
  return to_string(found)
}

pattern Main1(_: String) -> String {
  let rep = ds.DutyBootstrap()
  let rep2 = dl.DlBootstrap()
  let dl07 = CountPromptPayload("DlTickAll", "07:00|Europe/Minsk")
  let dl0830 = CountPromptPayload("DlTickAll", "08:30|Europe/Minsk")
  let duty = CountPromptPayload("DutyTickAll", "")
  let old = CountOld()
  let d_removed = redact(rep, "all")
  print("CRONMIG2 dl07=" + dl07 + " dl0830=" + dl0830 + " duty=" + duty + " old=" + old)
  print("CRONMIG2REP duty_report=" + redact(rep, "all") + " || dl_report=" + redact(rep2, "all"))
  return "cronmig2 done"
}

flow Main {
  input: String = "" -> Main1 -> output
}
